# Normalise line endings; the scripts run on Linux, so they must keep LF even when
# checked out on Windows (core.autocrlf=true would otherwise break the shebang).
* text=auto
*.sh   text eol=lf
*.py   text eol=lf
*.cron text eol=lf
*.conf text eol=lf

# vendored, minified libraries: don't diff them
web/vendor/** -diff linguist-vendored

*.bin  binary
*.gpkg binary
*.gz   binary
